# Database connection string (PostgreSQL or SQLite fallback for local testing)
DATABASE_URL=sqlite:///./app.db
# Symmetric encryption key for securing Google refresh tokens (Fernet 32-byte urlsafe base64 string)
ENCRYPTION_KEY=dGhpcy1pcy1hLXRlc3QtZW5jcnlwdGlvbi1rZXktMTIzNDU2Nzg=
# Environment name (development, staging, production)
ENVIRONMENT=development
# Google OAuth Client ID
GOOGLE_CLIENT_ID=your-google-client-id
# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Google OAuth Redirect URI
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback
